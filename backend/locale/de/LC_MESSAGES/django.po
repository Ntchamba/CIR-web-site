msgstr "Dieser Entwurf wurde bereits bearbeitet."

#: apps/assistant/services.py:70
msgid "Écrivez votre question."
msgstr "Schreiben Sie Ihre Frage."

#: apps/assistant/services.py:72
msgid "Le message est trop long (1000 caractères au plus)."
msgstr "Die Nachricht ist zu lang (höchstens 1000 Zeichen)."

#: apps/assistant/services.py:293
msgid "Indiquez si la réponse était utile (vrai ou faux)."
msgstr "Geben Sie an, ob die Antwort hilfreich war (wahr oder falsch)."

#: apps/assistant/services.py:391
msgid "Type de brouillon inconnu."
msgstr "Unbekannter Entwurfstyp."

#: apps/assistant/services.py:409
msgid "Indiquez l'identifiant de la demande ou de la conversation."
msgstr "Geben Sie die Kennung der Anfrage oder der Unterhaltung an."

#: apps/assistant/services.py:507
msgid "État inconnu : accepte, modifie ou rejete."
msgstr "Unbekannter Status: accepte, modifie oder rejete."

#: apps/assistant/services.py:535
msgid "Le contenu d'une réponse est un objet {texte}."
msgstr "Der Inhalt einer Antwort ist ein Objekt {texte}."

#: apps/assistant/services.py:538
msgid "Le texte est trop long (5000 caractères au plus)."
msgstr "Der Text ist zu lang (höchstens 5000 Zeichen)."

#: apps/assistant/services.py:396
msgid "Saisissez le texte français à traduire."
msgstr "Geben Sie den zu übersetzenden französischen Text ein."

#: apps/assistant/services.py:401
msgid "Choisissez parmi : en, zh, de, ja."
msgstr "Wählen Sie aus: en, zh, de, ja."

#: apps/assistant/services.py:404
msgid "Contexte inconnu : produit, actualite ou autre."
msgstr "Unbekannter Kontext: produit, actualite oder autre."

#: apps/assistant/services.py:527
msgid "Le contenu d'une traduction est un objet {langue: texte}."
msgstr "Der Inhalt einer Übersetzung ist ein Objekt {langue: texte}."

#: apps/assistant/services.py:517
msgid "Le texte modifié est obligatoire."
msgstr "Der geänderte Text ist erforderlich."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Dossier de médias introuvable : %(chemin)s."
msgstr "Medienordner nicht gefunden: %(chemin)s."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Manifeste introuvable : %(chemin)s."
msgstr "Manifest nicht gefunden: %(chemin)s."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Manifeste illisible : %(chemin)s."
msgstr "Manifest nicht lesbar: %(chemin)s."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Fichier de média manquant : %(fichier)s. Rien n'a été importé."
msgstr "Mediendatei fehlt: %(fichier)s. Es wurde nichts importiert."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Texte alternatif manquant pour %(fichier)s (langues : %(langues)s). Rien n'a été importé."
msgstr "Alternativtext fehlt für %(fichier)s (Sprachen: %(langues)s). Es wurde nichts importiert."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Médias de référence : %(accueil)s média(s) de l'accueil posé(s), %(creees)s photo(s) de la sphère créée(s), %(remplacees)s remplacée(s), %(inchangees)s déjà présente(s)."
msgstr "Referenzmedien: %(accueil)s Medien der Startseite gesetzt, %(creees)s Kugelfoto(s) erstellt, %(remplacees)s ersetzt, %(inchangees)s bereits vorhanden."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Nom de fichier non autorisé dans le manifeste : %(fichier)s."
msgstr "Dateiname im Manifest nicht erlaubt: %(fichier)s."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Fichier hors du dossier de médias ou non ordinaire : %(fichier)s."
msgstr "Datei außerhalb des Medienordners oder keine reguläre Datei: %(fichier)s."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Le dossier ne doit pas contenir de segment « .. » : %(chemin)s."
msgstr "Der Ordner darf kein Segment „..“ enthalten: %(chemin)s."

#: apps/contenus/management/commands/importer_medias_reference.py
msgid "Vidéo refusée : %(fichier)s (%(raison)s) Rien n'a été importé."
msgstr "Video abgelehnt: %(fichier)s (%(raison)s) Es wurde nichts importiert."
