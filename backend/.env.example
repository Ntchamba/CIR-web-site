# Copier ce fichier en backend/.env puis adapter les valeurs. Ne jamais versionner .env.

# --- Général ---
# config.settings.dev en local ; config.settings.prod sur Railway
DJANGO_SETTINGS_MODULE=config.settings.dev
# Production : au moins 50 caractères aléatoires
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production (défaut si vide) : site, www, tableau de bord (https://admin.revelation-sarl.com) et API
DJANGO_CSRF_TRUSTED_ORIGINS=
# Adresse cachée de l'administration Django (porte technique, distincte du tableau de bord)
DJANGO_ADMIN_URL=gestion-interne/

# --- Base de données ---
# Développement : SQLite (backend/db.sqlite3), rien à renseigner. Chemin facultatif :
SQLITE_PATH=
# Production : fournie par le service PostgreSQL de Railway, ex. postgres://user:mdp@hote:5432/cir
DATABASE_URL=

# --- Front-ends autorisés à appeler l'API (site public et tableau de bord) ---
# Production (défaut si vide) : https://revelation-sarl.com,https://www.revelation-sarl.com,https://admin.revelation-sarl.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Cache et WebSocket ---
# Vide : mémoire du processus (un seul processus). Production conseillée : redis://…
REDIS_URL=

# --- Jetons JWT ---
JWT_ACCES_MINUTES=30
JWT_RAFRAICHISSEMENT_JOURS=7

# --- Production (facultatif) ---
# Nombre de proxys de confiance devant l'application (adresse du client lue dans X-Forwarded-For).
# Par défaut : 1 en production (Railway), 0 en développement (X-Forwarded-For ignoré).
DJANGO_NOMBRE_PROXIES=
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDES=31536000
DJANGO_HSTS_PRELOAD=0
DJANGO_MEDIA_ROOT=

# --- E-mails ---
DEFAULT_FROM_EMAIL=CIR <no-reply@revelation-sarl.com>

# --- Services externes (vagues suivantes, backend/integrations/) ---
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
JAAS_APP_ID=
GMAIL_CLIENT_ID=
GEMINI_API_KEY=
