# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.

# --- Général ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Adresse cachée de l'administration Django (porte d'entrée technique, hors dashboard)
DJANGO_ADMIN_URL=gestion-interne/

# --- Base de données ---
# Laisser POSTGRES_DB vide pour utiliser SQLite en développement.
POSTGRES_DB=
POSTGRES_USER=cir
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Front-ends autorisés à appeler l'API (site public et dashboard) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Messagerie instantanée ---
# Vide : canal en mémoire (un seul processus, développement). En production : redis://…
REDIS_URL=

# --- Compte administrateur créé par « python manage.py seed_demo » ---
SEED_ADMIN_EMAIL=admin@cir.cm
SEED_ADMIN_PASSWORD=ChangeMoi-2026!

# --- Modules à venir (laisser vide pour l'instant) ---
# E-mails via Gmail (notifications, formulaire de contact)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Paiement par compte bancaire
BANK_PROVIDER=
# Téléphonie (opérateurs locaux et internationaux)
TELEPHONY_PROVIDER=
