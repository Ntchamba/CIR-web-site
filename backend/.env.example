# Copier ce fichier en backend/.env puis adapter les valeurs. Ne jamais versionner .env.

# --- Général ---
# config.settings.dev en local ; config.settings.prod sur Railway
DJANGO_SETTINGS_MODULE=config.settings.dev
# Production : au moins 50 caractères aléatoires
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# Production : api.revelation-sarl.com et l'adresse Railway du service (séparées par des virgules).
# « healthcheck.railway.app » (sonde de santé de Railway) est ajouté automatiquement en production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production (défaut si vide) : site, www, tableau de bord (https://admin.revelation-sarl.com) et API
DJANGO_CSRF_TRUSTED_ORIGINS=
# Adresse cachée de l'administration Django (porte technique, distincte du tableau de bord)
DJANGO_ADMIN_URL=gestion-interne/

# --- Base de données ---
# Développement : SQLite (backend/db.sqlite3), rien à renseigner. Chemin facultatif :
SQLITE_PATH=
# Production : fournie par le service PostgreSQL de Railway, ex. postgres://user:mdp@hote:5432/cir
DATABASE_URL=

# --- Front-ends autorisés à appeler l'API (site public et tableau de bord) ---
# Production (défaut si vide) : https://revelation-sarl.com,https://www.revelation-sarl.com,https://admin.revelation-sarl.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Cache et WebSocket ---
# Vide : mémoire du processus (un seul processus). Production conseillée : redis://…
REDIS_URL=

# --- Jetons JWT ---
JWT_ACCES_MINUTES=30
JWT_RAFRAICHISSEMENT_JOURS=7

# --- Production (facultatif) ---
# Nombre de proxys de confiance devant l'application (adresse du client lue dans X-Forwarded-For).
# Par défaut : 1 en production (Railway), 0 en développement (X-Forwarded-For ignoré).
DJANGO_NOMBRE_PROXIES=
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDES=31536000
DJANGO_HSTS_PRELOAD=0
# Dossier des fichiers envoyés (images, vidéos). Production : chemin du volume Railway, ex. /data/media
DJANGO_MEDIA_ROOT=
# 1 (défaut) : Django sert /media/ avec un en-tête de cache ; 0 si un autre service s'en charge
DJANGO_SERVIR_MEDIAS=1

# --- E-mails ---
DEFAULT_FROM_EMAIL=CIR <no-reply@revelation-sarl.com>

# Dossier PRIVÉ des pièces jointes de la messagerie (jamais servi par /media/). Production : volume Railway, ex. /data/prive
DJANGO_PRIVATE_ROOT=

# --- Adresses publiques (liens des e-mails) ---
# Site public, ex. https://revelation-sarl.com
SITE_URL=http://localhost:5173
# Tableau de bord (liens des e-mails de l'équipe), ex. https://admin.revelation-sarl.com
ADMIN_URL_PUBLIQUE=http://localhost:5174
# API (lien de désabonnement des nouveautés), ex. https://api.revelation-sarl.com
API_URL_PUBLIQUE=http://localhost:8000

# --- Appels vidéo : Jitsi as a Service (backend/integrations/jaas/) ---
# Non configuré : les boutons d'appel sont masqués, l'API répond 503 « appels_non_configures »
JAAS_APP_ID=
JAAS_KEY_ID=
# Clé privée RSA au format PEM ; les retours à la ligne peuvent être écrits \n
JAAS_PRIVATE_KEY=
# Secret partagé du webhook (en-tête X-Webhook-Secret)
JAAS_WEBHOOK_SECRET=
# Offre gratuite : 25 utilisateurs actifs par mois
JAAS_LIMITE_GRATUITE=25

# --- E-mails : API Gmail (backend/integrations/gmail/) ---
# Non configuré : les e-mails restent en file d'attente (console en développement)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Adresse d'envoi
GMAIL_EXPEDITEUR=
GMAIL_LIMITE_JOUR=400
# 1 (développement, tests) : envoi tenté juste après l'action ; 0 (production) : par le service « worker »
#   python manage.py envoyer_emails --boucle
NOTIFICATIONS_ENVOI_IMMEDIAT=1

# --- Services externes (vagues suivantes, backend/integrations/) ---
# --- Paiements CamPay (backend/integrations/campay/, module apps/paiements) ---
# Non configuré : le bouton « Payer » du site est masqué ; l'équipe peut enregistrer un règlement hors ligne.
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Production : https://www.campay.net/api ; essais : https://demo.campay.net/api
CAMPAY_BASE_URL=https://www.campay.net/api
# Clé de signature des webhooks (console CamPay). Adresse du webhook à saisir dans CamPay :
#   <API_URL_PUBLIQUE>/api/paiements/webhooks/campay/
CAMPAY_WEBHOOK_KEY=
# Montant minimum d'un paiement (FCFA) et durée avant l'expiration d'un paiement en attente
PAIEMENT_MONTANT_MINIMUM=100
PAIEMENT_EXPIRATION_MINUTES=15

# --- Assistant IA : API Gemini (backend/integrations/gemini/, module apps/assistant) ---
# Non configuré : la bulle d'assistant du site est masquée, l'API répond 503 « assistant_non_configure ».
GEMINI_API_KEY=
GEMINI_MODELE_ASSISTANT=gemini-2.5-flash
GEMINI_MODELE_FOND=gemini-2.5-flash
# Messages d'assistant par jour pour tout le site (protège le budget)
ASSISTANT_LIMITE_JOUR=1000
# Conservation des conversations (jours) ; la purge est faite par le worker (envoyer_emails --boucle)
ASSISTANT_RETENTION_JOURS=90
# Dossier des prompts (agents/). Défaut : backend/agents/ (facultatif)
ASSISTANT_AGENTS_DIR=
